<?xml version="1.0" encoding="utf-8"?>
<!--
    A BookSound server inside the home network is usually reached over plain http
    (e.g. http://192.168.1.10:8080); from the internet it is https through the router.
    The address the user types decides; one without a scheme gets https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
