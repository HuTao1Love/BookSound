<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Torrent downloads are large, temporary and tied to this device. -->
    <exclude domain="external" path="torrent-downloads/" />
    <!-- Server tokens belong to this device: restored elsewhere they would sign both devices out. -->
    <exclude domain="sharedpref" path="server_account.xml" />
</full-backup-content>
